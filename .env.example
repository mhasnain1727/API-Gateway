# API Gateway Configuration
NODE_ENV=development
# Port (change if 3000 is in use: EADDRINUSE - e.g. PORT=3010, or stop the process using 3000)
PORT=3000

# MongoDB Configuration (for Audit Logs). Leave empty to run without MongoDB (audit logging disabled).
MONGODB_URI=mongodb://localhost:27017/ics_gateway_audit

# Gateway only checks presence of Authorization: Bearer <token> for non-public APIs (no JWT verification here).

# Service URLs
IAM_SERVICE_URL=http://127.0.0.1:3002
AUTHZ_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:3003
CUSTOMER_SERVICE_URL=http://localhost:3004
WAREHOUSE_SERVICE_URL=http://localhost:3005

# CORS Configuration (comma-separated). In NODE_ENV!=production, http(s)://localhost:* and 127.0.0.1:* are allowed automatically.
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:4201,http://localhost:5173,http://localhost:3008,http://127.0.0.1:3000,http://127.0.0.1:4200,http://127.0.0.1:5173,http://127.0.0.1:3008

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# Logging
LOG_LEVEL=info

# Permission Cache Settings (Global consistency)
PERMISSION_CACHE_REDIS_TTL_SECONDS=36000
